# Copy this file to `.env.local` and fill in values as phases are built.
# NEVER put real secrets in files that get committed.

# ── Site ──────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── GitHub (optional; public API works unauthenticated with low rate limits)
# GITHUB_TOKEN=

# ── Supabase (Phase 2 — content platform & admin)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=   # server-only, never expose

# ── Social publishing (Phase 4 — official APIs only)
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
